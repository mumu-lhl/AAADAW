desc:AAADAW MIDI Send Bus Probe
options:gmem=aaadaw_midi_send_bus_probe

@init
ext_midi_bus = 1;

@block
while (midirecv(offset, message, data)) (
  status = message & 240;
  channel = message & 15;
  data2 = (data >> 8) & 255;
  status == 144 && data2 > 0 ? (
    gmem[channel] += 1;
    gmem[112 + midi_bus] += 1;
  );
  midisend(offset, message, data);
);
